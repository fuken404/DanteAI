TELEGRAM_TOKEN=tu_token_de_botfather
ANTHROPIC_API_KEY=tu_api_key_de_anthropic
GROQ_API_KEY=tu_api_key_de_groq
DATABASE_URL=postgresql://usuario:clave@host/dante?sslmode=require

# IDs de Telegram con acceso, separados por coma. Vacío: nadie puede usar el bot.
ALLOWED_USER_IDS=

# Solo en modo webhook. Si no hay URL pública, el bot usa polling.
# En Render, RENDER_EXTERNAL_HOSTNAME reemplaza a WEBHOOK_URL.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Opcional: cambiar modelos.
# CLAUDE_MODEL=claude-opus-5-5
# MEMORY_MODEL=claude-haiku-5-5
